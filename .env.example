# ===== Obrigatórias =====
# Postgres do Supabase. Na Vercel use a string do "Transaction pooler" (porta 6543), copiada do botão Connect.
DATABASE_URL=postgres://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# Segredos: gere valores longos e aleatórios, por exemplo:  openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# Endereço público do app, com https (o domínio da Vercel). O Instagram abre as mídias por URLs públicas.
APP_URL=https://seu-app.vercel.app

# ===== Supabase Storage (fotos e vídeos) =====
# Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=midia

# ===== Agendamento =====
# Senha do endpoint /api/cron/tick, usado pelo Supabase pg_cron ou pelo Vercel Cron.
CRON_SECRET=

# ===== Opcionais =====
# Depois de criar a sua conta, coloque false para fechar o cadastro.
ALLOW_SIGNUP=true
# Textos gerados por IA (botão "Refazer com IA").
ANTHROPIC_API_KEY=
# GRAPH_VERSION=v21.0        (versão da API do Instagram/Meta)
# APP_TZ=America/Sao_Paulo
# DATABASE_SSL_CA=           (certificado CA do banco, para verificar o SSL; sem isso a conexão é criptografada mas não verificada)

# ===== Só para rodar migrações no seu computador =====
# Conexão DIRETA do Supabase (porta 5432), usada por:  npm run migrate
# MIGRATE_DATABASE_URL=postgres://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# ===== Só para servidor próprio (Docker/VPS), sem Supabase Storage =====
# UPLOAD_DIR=/app/data/uploads
# COOKIE_SECURE=false        (só para testar em http fora do localhost)
